{
  "name": "eternum-extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bibliothecadao/dojo": "workspace:*",
    "@bibliothecadao/eternum": "workspace:*",
    "@bibliothecadao/provider": "workspace:*",
    "@bibliothecadao/torii": "workspace:*",
    "@bibliothecadao/types": "workspace:*",
    "@cartridge/connector": "catalog:",
    "@cartridge/controller": "catalog:",
    "@dojoengine/core": "catalog:",
    "@dojoengine/recs": "catalog:",
    "@dojoengine/state": "catalog:",
    "@dojoengine/torii-client": "catalog:",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@starknet-react/chains": "catalog:",
    "@starknet-react/core": "catalog:",
    "class-variance-authority": "^0.7.0",
    "clsx": "^1.2.1",
    "lucide-react": "^0.365.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "starknet": "catalog:",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0",
    "wxt": "^0.19.0"
