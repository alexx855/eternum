{
  "name": "eternum-extension",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "pnpm --dir ../../../packages/types build && wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "knip": "cd ../../.. && pnpm dlx knip@5.80.0 --config client/apps/extension/knip.json --workspace client/apps/extension --include files,exports,types,dependencies,unlisted",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@bibliothecadao/types": "workspace:*",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^1.2.1",
    "lucide-react": "^0.365.0",
    "react": "catalog:game",
    "react-dom": "catalog:game",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.5.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0",
    "wxt": "^0.19.0",
    "vitest": "^2.1.9",
    "eslint": "^9.17.0",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^28.0.0"
  }
}
